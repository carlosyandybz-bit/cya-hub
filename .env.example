NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional release identifier shown by /api/build-info. Prefer the deployed Git commit SHA.
CYA_BUILD_SHA=

# Sentry runtime monitoring. The DSN is a public ingestion identifier, not a secret.
# CYA Hub also contains the current public DSN as a safe fallback so runtime error capture works after deploy.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ORG=cya-de
SENTRY_PROJECT=organization-slug
# Server/build only. Never expose this as NEXT_PUBLIC_* or commit its value.
SENTRY_AUTH_TOKEN=

# Google Drive server integration. Keep these server-only in Hostinger.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional. Leave empty to let CYA Hub create/manage its own private Drive folder with drive.file scope.
GOOGLE_DRIVE_TEACHING_FOLDER_ID=
GOOGLE_DRIVE_TEACHING_FOLDER_NAME=CYA Hub - Enseñanza
# Optional destination dedicated to class videos. If empty, class videos use the managed teaching folder.
GOOGLE_DRIVE_CLASS_VIDEOS_FOLDER_ID=
# Optional destination dedicated to student Feedback Online videos. If empty, CYA Hub creates/manages this private folder.
GOOGLE_DRIVE_FEEDBACK_FOLDER_ID=
GOOGLE_DRIVE_FEEDBACK_FOLDER_NAME=CYA Hub - Feedback Online

# Google Calendar OAuth. Client ID/secret fall back to the Drive OAuth client when these are empty.
# Add the production callback URL to the OAuth client: https://<tu-dominio>/api/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional explicit callback. Leave empty to derive it from the current CYA Hub origin.
GOOGLE_CALENDAR_REDIRECT_URI=
CYA_SERVER_SECRET=

# WhatsApp Business Platform / Cloud API. Keep every value server-only in Hostinger.
# Never expose these variables as NEXT_PUBLIC_* and never commit their real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Pin the Graph API version configured for the Meta app (format vNN.N).
WHATSAPP_GRAPH_API_VERSION=
# Configure the Meta webhook callback as https://<tu-dominio>/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
