# CYA Hub — STAGING ONLY
# Never place production secrets or production Supabase credentials in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_staging_key

# Release/build identification
CYA_BUILD_SHA=

# Keep staging errors separated from production in Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_ORG=cya-de
SENTRY_PROJECT=organization-slug
SENTRY_AUTH_TOKEN=

# Google Drive — use test credentials/resources where possible.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_TEACHING_FOLDER_ID=
GOOGLE_DRIVE_TEACHING_FOLDER_NAME=CYA Hub - Enseñanza - STAGING
GOOGLE_DRIVE_CLASS_VIDEOS_FOLDER_ID=
GOOGLE_DRIVE_FEEDBACK_FOLDER_ID=
GOOGLE_DRIVE_FEEDBACK_FOLDER_NAME=CYA Hub - Feedback Online - STAGING

# Google Calendar — staging callback must be separately authorized in Google OAuth.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://<staging-domain>/api/google-calendar/callback
CYA_SERVER_SECRET=
